# 复制为本地 .env 后填写；.env 已忽略，切勿提交密钥。
LLM_PROVIDER=bailian
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
YUNYUN_MODE=web
# PC 启动时通过 --workspace 授权，不通过 Web 请求指定服务器目录。
# YUNYUN_DATA_DIR=.runtime
# 显式设置 LLM_PROVIDER=mock 才会进入 MOCK_LLM，API 失败不会自动降级。
# PC 启动器强制 pc 模式并生成本机能力口令；不要在这里固定口令。
# 公网须加入实际 Host 并通过 HTTPS 设置安全 cookie；本机默认 false。
YUNYUN_HOSTS=localhost,127.0.0.1,testserver
YUNYUN_SECURE_COOKIE=false
# 私有执行器：按 README 配置，或 PC 使用 --runner-ssh；不是公网 URL。
# RUNNER_SOCKET=/绝对路径/受限目录/runner.sock
# RUNNER_TOKEN=由运维安全配置的至少32字符随机值
# API 不能拥有 Docker Socket。RUNNER_IMAGE 仅配置在独立 Manager 中。
# 模型调用没有费用、累计Token、次数或总时长预算；只记录实际usage。
# 单次请求超时仍用于失败恢复，不是累计调用预算。
MODEL_TIMEOUT_SECONDS=60
# 可选：更换模型时配置每百万token价格，仅用于费用估算，不影响调用：
# LLM_INPUT_CNY_PER_MILLION=
# LLM_OUTPUT_CNY_PER_MILLION=
